#!/usr/bin/env python3
import json
import re
import subprocess
import tempfile
from pathlib import Path

def extract_video_id(url_or_id):
    if len(url_or_id) == 11 and "/" not in url_or_id:
        return url_or_id
    match = re.search(r'(?:v=|youtu\.be/|embed/)([A-Za-z0-9_-]{11})', url_or_id)
    return match.group(1) if match else None

def _analyze_frame(image_path):
    result = subprocess.run(
        ["ollama", "run", "moondream", "Describe what you see in this image, focus on any interfaces, screens, applications, or tools being shown: " + str(image_path)],
        capture_output=True, text=True, timeout=60
    )
    return result.stdout.strip()

def watch_video_visual(url_or_id, num_frames=3):
    video_id = extract_video_id(url_or_id)
    if not video_id:
        return {"error": "Could not extract video ID"}

    with tempfile.TemporaryDirectory() as tmpdir:
        video_path = Path(tmpdir) / "video.mp4"
        dl_result = subprocess.run(
            ["yt-dlp", "-f", "bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]", "-o", str(video_path), f"https://www.youtube.com/watch?v={video_id}"],
            capture_output=True, text=True, timeout=120
        )
        if not video_path.exists():
            return {"error": "Could not download video for frame extraction", "details": dl_result.stderr[:300]}

        duration_result = subprocess.run(
            ["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "default=noprint_wrappers=1:nokey=1", str(video_path)],
            capture_output=True, text=True, timeout=30
        )
        try:
            duration = float(duration_result.stdout.strip())
        except Exception:
            duration = 60

        frame_descriptions = []
        for i in range(num_frames):
            timestamp = duration * (i + 1) / (num_frames + 1)
            frame_path = Path(tmpdir) / f"frame_{i}.png"
            subprocess.run(
                ["ffmpeg", "-ss", str(timestamp), "-i", str(video_path), "-frames:v", "1", "-y", str(frame_path)],
                capture_output=True, timeout=30
            )
            if frame_path.exists():
                description = _analyze_frame(frame_path)
                frame_descriptions.append({"timestamp": round(timestamp, 1), "description": description})

        return {"video_id": video_id, "visual_frames": frame_descriptions}

if __name__ == "__main__":
    import sys
    q = sys.argv[1] if len(sys.argv) > 1 else "dQw4w9WgXcQ"
    print(json.dumps(watch_video_visual(q), indent=2))
