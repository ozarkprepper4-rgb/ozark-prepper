        },
        "model_response": dl_result["model_response"],
        "dl_result": dl_result,
        "learning_record": learning,
        "predictor": predictor_result,
        "adaptive_rules_applied": applied_rules,
        "updated_directives": updated_cognitive.get(
            "cognitive_directives", []
        ),
        "duration_seconds": duration,
        "status": "PASS"
    }

    existing = load_json(ORCHESTRATOR_LOG, [])

    if not isinstance(existing, list):
        existing = []

    existing.append(result)

    ORCHESTRATOR_LOG.parent.mkdir(parents=True, exist_ok=True)

    ORCHESTRATOR_LOG.write_text(
        json.dumps(existing, indent=2),
        encoding="utf-8"
    )

    # ---------------------------------------------------------
    # PHASE 7 — Preserve verified knowledge
    # ---------------------------------------------------------
    knowledge_captured = capture(
        task,
        {
            "status": "PASS",
            "model_response": dl_result.get("model_response", ""),
            "verified_facts": verified_facts,
            "tool_result": tool_result
        }
    )

    return result



def run(task):
    try:
        return _run_core(task)
    except Exception as exc:
        repair = _last_resort_repair(task, exc)

        if repair.get("status") == "repair_applied":
            try:
                # Reload the repaired module so the retry uses the new code,
                # not an old copy already sitting in Python memory.
                target = repair.get("target")

                if target:
                    import importlib

                    importlib.invalidate_caches()

                    target_path = Path(target).resolve()
                    this_file = Path(__file__).resolve()

                    if target_path != this_file:
                        for module_name, module in list(sys.modules.items()):
                            module_file = getattr(module, "__file__", None)

                            if not module_file:
                                continue

                            try:
                                if Path(module_file).resolve() != target_path:
                                    continue
                            except Exception:
                                continue

                            # Remember any functions imported directly into
                            # cognitive_orchestrator from this module.
                            bindings = {}

                            for global_name, obj in list(globals().items()):
                                if getattr(obj, "__module__", None) == module_name:
                                    attr_name = getattr(obj, "__name__", None)
                                    if attr_name:
                                        bindings[global_name] = attr_name

                            reloaded = importlib.reload(module)

                            # Rebind direct imports to the freshly loaded code.
                            for global_name, attr_name in bindings.items():
                                if hasattr(reloaded, attr_name):
                                    globals()[global_name] = getattr(
                                        reloaded,
                                        attr_name
                                    )

                            break

                result = _run_core(task)

                # Keep the repair only if Destiny's normal pipeline says
                # the original task actually succeeded.
                if not isinstance(result, dict) or result.get("status") != "PASS":
                    backup = repair.get("backup")
                    if backup:
                        from shutil import copy2
                        copy2(backup, repair.get("target"))

                        # Reload the restored module so memory matches disk.
                        if target and target_path != this_file:
                            importlib.invalidate_caches()
                            for module_name, module in list(sys.modules.items()):
                                module_file = getattr(module, "__file__", None)
                                if not module_file:
                                    continue
                                try:
                                    if Path(module_file).resolve() == target_path:
                                        importlib.reload(module)
                                        break
                                except Exception:
                                    continue

                    return {
                        "status": "FAIL",
                        "task": task,
                        "error": "Repair retry did not pass Destiny's normal success check.",
                        "repair": repair,
                        "retry_result": result,
                        "message": "The repair was rejected and the original file was restored."
                    }

                result.setdefault("pipeline", {})["last_resort_repair"] = "PASS"
                result["repair"] = repair

                return result

            except Exception as retry_exc:
                backup = repair.get("backup")
                if backup:
                    try:
                        from shutil import copy2
                        copy2(backup, repair.get("target"))
                    except Exception:
                        pass
                return {
                    "status": "FAIL",
                    "task": task,
                    "error": str(retry_exc),
                    "repair": repair,
                    "message": "Repair was applied but the retry failed. The repaired file was restored from backup."
                }

        return {
            "status": "FAIL",
            "task": task,
            "error": str(exc),
            "repair": repair
        }

