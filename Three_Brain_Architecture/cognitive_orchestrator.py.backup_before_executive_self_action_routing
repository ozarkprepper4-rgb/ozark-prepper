        "source": "Three-Brain Cognitive Orchestrator"
    }

    # ---------------------------------------------------------
    # PHASE 2 — Execute real Destiny model
    # ---------------------------------------------------------

    from verify import run_command
    tool_result = None
    _note = re.search(r"(?:write|create).*?note called\s+([A-Za-z0-9_\-]+\.md).*?(?:that says|with exactly these words:)\s*(.+)$", task, re.IGNORECASE)
    if _note:
        _path = Path("/home/destiny/Obsidian/Destiny") / _note.group(1)
        _path.write_text(_note.group(2).strip() + "\n", encoding="utf-8")
        tool_result = {"command": "write_note", "exit_code": 0, "stdout": str(_path), "stderr": ""}
    _read = re.search(r"(?:read|open|what does)\s+([A-Za-z0-9_\-]+\.md)", task, re.IGNORECASE)
    if tool_result is None and re.search(r"\blist\b.*\bnotes\b", task, re.IGNORECASE):
        _vault = Path("/home/destiny/Obsidian/Destiny")
        _names = sorted([x.name for x in _vault.glob("*.md")])[:10]
        tool_result = {"command": "list_notes", "exit_code": 0, "stdout": "\n".join(_names), "stderr": ""}

    if tool_result is None and _read:
        _path = Path("/home/destiny/Obsidian/Destiny") / _read.group(1)
        if _path.exists():
