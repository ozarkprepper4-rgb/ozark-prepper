        else:
            tool_result = {"command": "read_note", "exit_code": 1, "stdout": "", "stderr": "missing " + str(_path)}
    if tool_result is None and ("run this exact command" in lower_task or "using your run_command tool" in lower_task):
        cmd_match = re.search(r"(?:run this exact command[^:]*:|using your run_command tool[^:]*:)\s*(.+)$", task, re.IGNORECASE)
        if cmd_match:
            real_cmd = cmd_match.group(1).strip()
            tool_result = run_command(real_cmd)
    direct_tool_completed = tool_result is not None
    context["tool_result"] = tool_result

    dl_result = run_reasoning_task(task, context)

    if dl_result.get("status") != "READY":
        raise RuntimeError("DL Brain failed.")
    if tool_result is None:
        import re as _re_auto
        _text = dl_result.get("model_response") or ""
        _m = _re_auto.search(r"I need to run `([^`]+)`", _text)
        if not _m:
            _m = _re_auto.search(r"shell command:\s*`([^`]+)`", _text)
        if not _m:
            _m = _re_auto.search(r"run this exact command:\s*`([^`]+)`", _text)
        if _m:
            _cmd = _m.group(1).strip()
            if _cmd.startswith("touch ") and "/" not in _cmd:
                _cmd = "touch /home/destiny/Obsidian/Destiny/" + _cmd.split(" ", 1)[1]
            tool_result = run_command(_cmd) if 'THE_COMMAND_HERE' not in _cmd else tool_result

    is_video_task = "youtube.com" in task or "youtu.be" in task
    if is_video_task and dl_result.get("model_response"):
        log_path = Path("/home/destiny/Obsidian/Destiny/Video_Learning_Log.md")
        entry = f"\n\n## {datetime.now(timezone.utc).strftime('%Y-%m-%d %H:%M UTC')}\n**Video Task:** {task}\n**What I Learned & My Applied Version:**\n{dl_result['model_response']}\n---\n"
        with log_path.open("a", encoding="utf-8") as f:
            f.write(entry)

    if tool_result is not None and not direct_tool_completed:
        context["tool_result"] = tool_result
        context["continuation_after_tool"] = True
        dl_result = run_reasoning_task(task, context)
        if dl_result.get("status") != "READY":
            raise RuntimeError("DL Brain failed after tool execution.")
    if not dl_result.get("model_response"):
        raise RuntimeError("Destiny model returned no response.")

    duration = round(time.time() - start, 4)

    # ---------------------------------------------------------
    # PHASE 3 — Record experience
    # ---------------------------------------------------------

    learning = record_experience(
        task_type="cognitive_orchestrated_task",
        status="success",
        duration=duration,
        outcome=dl_result["model_response"],
        notes="Automated Three-Brain task."
