        try:
            from web_search import web_search
            clean_query = re.sub(r'.*?(search the web|actively search|search)\s*(for|about)?\s*', '', task, flags=re.IGNORECASE)
            clean_query = re.split(r'\band tell me\b|\.', clean_query)[0].strip()
