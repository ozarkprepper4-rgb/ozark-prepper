def load_json(path, default):
    if not path.exists():
        return default

    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return default


def run_predictor():
    result = subprocess.run(
        [sys.executable, str(PREDICTOR)],
        capture_output=True,
        text=True,
        check=False
    )

    return {
        "return_code": result.returncode,
        "stdout": result.stdout.strip(),
        "stderr": result.stderr.strip()
    }


def update_adaptive_brain():
    predictions = load_json(ML_RESULTS, {})
    rules = load_json(RULES, {})

    warnings = predictions.get("high_risk_patterns", [])
    applied = []

    for warning in warnings:

        if "controlled_test_research" in warning:
            key = "ml_adaptation_controlled_test_research"

            rules[key] = {
                "timestamp": datetime.now(timezone.utc).isoformat(),
                "source": "ML_Brain/prediction_results.json",
                "trigger": warning,
                "adaptation": "Increase verification and caution for research tasks.",
                "status": "applied"
            }

            applied.append(key)

        elif "fail_task" in warning:
            key = "ml_adaptation_fail_task"

            rules[key] = {
                "timestamp": datetime.now(timezone.utc).isoformat(),
                "source": "ML_Brain/prediction_results.json",
                "trigger": warning,
                "adaptation": "Increase verification of task completion before reporting success.",
                "status": "applied"
            }

            applied.append(key)

    RULES.write_text(
        json.dumps(rules, indent=2),
        encoding="utf-8"
    )

    return applied


def rebuild_cognitive_integration():
    rules = load_json(RULES, {})

    active = []

    for key, rule in rules.items():
        if isinstance(rule, dict) and rule.get("status") == "applied":
            instruction = rule.get("adaptation", "")

            if instruction:
                active.append({
                    "rule": key,
                    "instruction": instruction,
                    "trigger": rule.get("trigger", "")
                })

    cognitive = {
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "source": "ML_Brain → Adaptive_Brain → Cognitive Integration",
        "high_risk_patterns": load_json(
            ML_RESULTS, {}
        ).get("high_risk_patterns", []),
        "active_adaptive_rules": active,
        "cognitive_directives": [
            item["instruction"]
            for item in active
        ],
        "status": "READY"
    }

    COGNITIVE.parent.mkdir(parents=True, exist_ok=True)

    COGNITIVE.write_text(
        json.dumps(cognitive, indent=2),
        encoding="utf-8"
    )

    return cognitive



def _last_resort_repair(task, exc):
    import traceback
    import importlib.util
    import json

    repair_log = BASE / "Logs/last_resort_repair.json"
    tb_text = traceback.format_exc()
    target = None

    for frame in reversed(traceback.extract_tb(sys.exc_info()[2])):
        candidate = Path(frame.filename)
        if str(candidate).startswith(str(BASE)) and candidate.name not in {
            "diagnose_and_fix.py",
            "safe_self_edit.py"
        }:
            target = candidate
            break

    result = {
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "task": task,
        "error": str(exc),
        "target": str(target) if target else None
    }

    if target is None or not target.exists():
        result["status"] = "no_safe_target"
    else:
        try:
            path = BASE / "skills/diagnose_and_fix.py"
            spec = importlib.util.spec_from_file_location(
                "last_resort_diagnose", path
            )
            diag = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(diag)

            diagnosis = diag.run(
                str(target),
                "Unhandled Destiny exception.\n\nFull traceback:\n" + tb_text
            )

            result["diagnosis"] = diagnosis

            if diagnosis.get("status") == "applied":
                result["status"] = "repair_applied"
                result["backup"] = diagnosis.get("details", {}).get("backup")
            else:
                result["status"] = "repair_failed"

        except Exception as repair_error:
            result["status"] = "repair_error"
            result["repair_error"] = str(repair_error)

    repair_log.parent.mkdir(parents=True, exist_ok=True)

    existing = []
    if repair_log.exists():
        try:
            existing = json.loads(
                repair_log.read_text(encoding="utf-8")
            )
            if not isinstance(existing, list):
                existing = []
        except Exception:
            existing = []

    existing.append(result)
    repair_log.write_text(
        json.dumps(existing, indent=2),
        encoding="utf-8"
    )

    return result


def _run_core(task):
    _is_video_link_task = "youtube.com" in task or "youtu.be" in task
    if not _is_video_link_task:
        try:
            from vault_actions import handle as _vault_handle
            _executive_task = any(x in task.lower() for x in [
                "autonomous self-improvement",
                "autonomous loop",
                "take over completing your own",
                "inspect your capabilities"
            ])
            _acted = None if _executive_task else _vault_handle(task)
            if _acted:
                msg = _acted.get("stdout") if isinstance(_acted, dict) and "stdout" in _acted else str(_acted)
                return {"task": task, "pipeline": {"vault_actions": "PASS"}, "model_response": msg, "status": "PASS"}
        except Exception as _vault_err:
            print("vault_actions error:", _vault_err)

    # ---------------------------------------------------------
    # PHASE 0 — Mandatory pre-execution verification
    # ---------------------------------------------------------

    verification = verify_task(task)

    if verification.get("status") != "READY":
        return {
            "status": "BLOCKED",
            "pipeline": {
                "pre_execution_verification": "FAIL"
            },
            "verification": verification,
            "dl_result": {}
        }

    start = time.time()

    # ---------------------------------------------------------
    # PHASE 1 — Load current cognitive state
    # ---------------------------------------------------------

    ml = load_json(ML_RESULTS, {})
    cognitive = load_json(COGNITIVE, {})

    # Keep model context minimal for normal tasks.
    # Adaptive directives remain recorded in the cognitive layer,
    # but are not blindly injected into every model prompt.
    neil_soul = Path("/home/destiny/Obsidian/Destiny/SOUL.md").read_text(encoding="utf-8")[:3000] if Path("/home/destiny/Obsidian/Destiny/SOUL.md").exists() else ""
    destiny_soul = Path("/home/destiny/Obsidian/Destiny/Destiny.md").read_text(encoding="utf-8")[:3000] if Path("/home/destiny/Obsidian/Destiny/Destiny.md").exists() else ""

    # Conversation-only identity filter.
    # Keep the real Obsidian files unchanged, but stop repeatedly
    # priming the model to address the user by name.
    def _conversation_identity_filter(text):
        text = re.sub(r"\bNeil Wilcox\b", "the user", text)
        text = re.sub(r"\bNeil's\b", "the user's", text)
        text = re.sub(r"\bNeil\b", "the user", text)
        return text

    neil_soul = _conversation_identity_filter(neil_soul)
    destiny_soul = _conversation_identity_filter(destiny_soul)
    if not ("youtube.com" in task or "youtu.be" in task) and any(w in task.lower() for w in ["watch this video", "watch the video", "look up this video", "find this video"]):
        try:
            from video_search import search_youtube
            title_part = task
            for phrase in ["watch this video", "watch the video", "look up this video", "find this video", "titled", "called"]:
                title_part = title_part.replace(phrase, "").replace(phrase.title(), "")
            title_part = title_part.strip(" :\"'")
            found = search_youtube(title_part, max_results=1)
            if found:
                task = found[0]["url"]
        except Exception:
            pass

    video_content = ""
    if "youtube.com" in task or "youtu.be" in task:
        try:
            from video_watch import watch_video
            vresult = watch_video(task, max_chars=4000)
            video_content = vresult.get("transcript_summary", "")
            visual_keywords = ["see", "watch", "visual", "interface", "screen", "shown", "look like", "show me what"]
            if any(w in task.lower() for w in visual_keywords):
                try:
                    from video_watch_visual import watch_video_visual
                    visual_result = watch_video_visual(task, num_frames=3)
                    frames = visual_result.get("visual_frames", [])
                    if frames:
                        visual_text = "\n".join("At " + str(f["timestamp"]) + "s: " + f["description"] for f in frames)
                        video_content = video_content[:1800] + "\n\nVISUAL CONTENT OBSERVED IN VIDEO (what is actually shown on screen):\n" + visual_text
                except Exception:
                    pass
        except Exception:
            video_content = ""



    import json as _json
    pending_path = Path("/home/destiny/Obsidian/Destiny/Three_Brain_Architecture/pending_learning.json")
    pending_items = []
    if pending_path.exists():
        try:
            pending_items = _json.loads(pending_path.read_text())
        except Exception:
            pending_items = []

    verified_facts = None
    lower_task = task.lower()
    live_search_results = None
