from pathlib import Path
import json
import urllib.request
import fcntl
from datetime import datetime, timezone

def _ask_model(prompt):
    payload = {"model": "qwen2.5:14b", "prompt": prompt, "stream": False, "options": {"num_predict": 100, "temperature": 0.3}}
    req = urllib.request.Request("http://127.0.0.1:11434/api/generate", data=json.dumps(payload).encode(), headers={"Content-Type": "application/json"})
    lock_path = Path("/tmp/destiny_model_busy.lock")
    with lock_path.open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        lock.write("daily_priority_check:qwen")
        lock.flush()
        with urllib.request.urlopen(req, timeout=120) as r:
            return json.loads(r.read().decode()).get("response", "").strip()

def run():
    log_path = Path("/home/destiny/Obsidian/Destiny/Daily_Priority_Log.md")
    soul_path = Path("/home/destiny/Obsidian/SOUL.md")
    goal_text = ""
    if soul_path.exists():
        content = soul_path.read_text(encoding="utf-8")
        if "Primary Goal" in content:
            goal_text = content.split("Primary Goal")[-1][:600]

    ozark_path = Path("/home/destiny/Obsidian/Ozark Prepper/index.html")
    ozark_status = "Website exists and has ebooks listed." if ozark_path.exists() else "No website found yet."

    health_context = ""
    if soul_path.exists():
        soul_content = soul_path.read_text(encoding="utf-8")
        if "chronic" in soul_content.lower() or "stroke" in soul_content.lower():
            idx = soul_content.lower().find("neil is")
            if idx != -1:
                health_context = soul_content[idx:idx+400]

    recent_suggestions = ""
    if log_path.exists():
        try:
            log_content = log_path.read_text(encoding="utf-8")
            entries = log_content.split("**Next step identified:**")[1:]
            recent_suggestions = "\n".join(e.split("---")[0].strip()[:150] for e in entries[-3:])
        except Exception:
            recent_suggestions = ""

    vault_status = "Vault has no real financial data yet (empty categories: Banking, Stripe and Payments, PayPal, Purchasing, Subscriptions, Taxes, Bill Pay, Passwords and Emails, Affiliate Programs, Real Estate Documents, Contracts, Credit Cards, Real Estate Escrow)."

    prompt = "Your primary goal: " + goal_text + "\n\nWhy this matters (Neil real situation): " + health_context + "\n\nCurrent status: " + ozark_status + "\n\nSecure vault status: " + vault_status + "\n\nRecent suggestions already given (DO NOT repeat these, think of something genuinely different or more specific):\n" + recent_suggestions + "\n\nBased on this, identify ONE specific, concrete, DIFFERENT next step that would move toward the goal fastest. If the next step genuinely requires something from Neil that only he can provide (like a real API key, bank account number, or account credentials he would need to create), say so explicitly starting with NEED FROM NEIL: followed by exactly what is needed and why. Otherwise, give the next step normally. Be specific and practical, not vague, and not a repeat of the recent suggestions above. One or two sentences only."
    next_step = _ask_model(prompt)

    entry = "\n\n## " + datetime.now(timezone.utc).strftime('%Y-%m-%d %H:%M UTC') + "\n**Next step identified:** " + next_step + "\n---\n"
    with log_path.open("a", encoding="utf-8") as f:
        f.write(entry)

    return next_step
