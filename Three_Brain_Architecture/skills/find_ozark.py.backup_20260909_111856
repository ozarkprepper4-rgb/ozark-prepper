from pathlib import Path

ROOT = Path("/home/destiny/Obsidian")

def run(*a, **k):
    hits = []
    for f in ROOT.glob("**/*"):
        if f.is_file() and ("ozark" in f.stem.lower() or "ozark" in f.name[:-(f.suffix and len(f.suffix))].lower()):
            hits.append(str(f))
    return '\n'.join(sorted(hits)) if hits else 'none found'
