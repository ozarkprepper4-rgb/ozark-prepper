def _daily_priority_check():
    try:
        import sys, time as _t2
        sys.path.insert(0, str(SKILLS))
        import daily_priority_check
        tracker_path = Path("/home/destiny/Obsidian/Destiny/Three_Brain_Architecture/.priority_check_time.txt")
