from pathlib import Path
import time, sys
VAULT = Path("/home/destiny/Obsidian/Destiny")
ROOT = Path("/home/destiny/Obsidian")
SKILLS = Path("/home/destiny/Obsidian/Destiny/Three_Brain_Architecture/skills")
SKIP = {"Tests.md", "Conversation_Log.md", "Self_Check_Log.md", "Video_Learning_Log.md"}
def _inventory():
    agents = []
    for f in ROOT.rglob("*.md"):
        name = f.stem
        if name in ("Victoria", "Denise", "Pepper", "Audrey", "Bridget", "Chloe", "Clara", "Sentinel", "Provident", "Sustenance", "Comms"):
            agents.append(str(f))
    books = [str(p) for p in (ROOT / "Ozark Prepper").glob("ebook_*.md")] if (ROOT / "Ozark Prepper").exists() else []
    sites = [str(p) for p in (ROOT / "Ozark Prepper").glob("landing_*.html")] if (ROOT / "Ozark Prepper").exists() else []
    kb = VAULT / "Knowledge_Base.md"
    block = "\n## Self inventory " + time.strftime("%Y-%m-%d %H:%M") + "\n- agents: " + ", ".join(agents[:20]) + "\n- ebooks: " + ", ".join(Path(x).name for x in books) + "\n- landings: " + ", ".join(Path(x).name for x in sites) + "\n"
    if kb.exists():
        old = kb.read_text(encoding="utf-8")
        kb.write_text(old + block, encoding="utf-8")
    return "inventory agents=" + str(len(agents)) + " ebooks=" + str(len(books)) + " sites=" + str(len(sites))
def _web_learn():
    try:
        sys.path.insert(0, "/home/destiny/Obsidian/Destiny/Three_Brain_Architecture")
        from web_search import web_search
        notes = [f for f in sorted(ROOT.rglob("*.md")) if f.name not in SKIP and f.stat().st_size > 0 and "Ozark Prepper" not in str(f) and "ebook_" not in f.name.lower()]
        if not notes:
            return "web none"
        tracker_path = Path("/home/destiny/Obsidian/Destiny/Three_Brain_Architecture/.web_learn_index.txt")
        last_index = -1
        if tracker_path.exists():
            try:
                last_index = int(tracker_path.read_text().strip())
            except Exception:
                last_index = -1
        next_index = (last_index + 1) % len(notes)
        tracker_path.write_text(str(next_index))
        note = notes[next_index]
        hits = web_search(note.stem.replace("_", " ") + " local offline", max_results=2)
        old = note.read_text(encoding="utf-8")
        stamp = time.strftime("%Y-%m-%d %H:%M")
        add = "\n\n## Web learn " + stamp + "\n" + str(hits)[:800] + "\n"
        if "## Web learn " + stamp not in old:
            note.write_text(old + add, encoding="utf-8")
        return "web " + note.name
    except Exception as e:
        return "web skip " + str(e)
def _self_check_and_repair():
    try:
        import sys, random, time as _t
        sys.path.insert(0, str(SKILLS))
        import diagnose_and_fix
        core_files = [Path("/home/destiny/Obsidian/Destiny/Three_Brain_Architecture") / f for f in ["vault_actions.py", "conversation_engine.py"]]
        skill_files = [f for f in SKILLS.glob("*.py") if f.name not in ("diagnose_and_fix.py", "safe_self_edit.py") and f.stat().st_size < 5000]
        all_candidates = [f for f in core_files if f.exists() and f.stat().st_size < 15000] + skill_files

        priority_candidates = []
        failures_path = Path("/home/destiny/Obsidian/Destiny/Auto_Forge_Failures.md")
        if failures_path.exists():
            try:
                recent_failures = failures_path.read_text(encoding="utf-8")[-3000:]
                for f in all_candidates:
                    if f.name in recent_failures:
                        priority_candidates.append(f)
            except Exception:
                pass

        candidates = priority_candidates if priority_candidates else all_candidates
        if not candidates:
            return "self-repair: no candidates"
        cooldown_path = Path("/home/destiny/Obsidian/Destiny/Three_Brain_Architecture/.repair_cooldown.json")
        import json as _json
        cooldowns = {}
        if cooldown_path.exists():
            try:
                cooldowns = _json.loads(cooldown_path.read_text())
            except Exception:
                cooldowns = {}
        now = _t.time()
        eligible = [f for f in candidates if now - cooldowns.get(f.name, 0) > 21600]
        if not eligible:
            return "self-repair: all files recently checked, skipping"
        pick = eligible[int(_t.time() / 120) % len(eligible)]
        result = diagnose_and_fix.run(str(pick), "Review this file for any REAL bugs, broken logic, or actual errors that would cause it to malfunction. Only make a change if there is a genuine functional problem. Cosmetic or stylistic differences that do not change behavior are NOT bugs - leave those alone.")
        cooldowns[pick.name] = now
        cooldown_path.write_text(_json.dumps(cooldowns))
        return "self-repair checked " + pick.name + ": " + str(result.get("status", "unknown"))
    except Exception as e:
        return "self-repair skip " + str(e)


