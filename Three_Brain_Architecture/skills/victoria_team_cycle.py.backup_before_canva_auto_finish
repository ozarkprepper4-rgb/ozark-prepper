def _ask(prompt):
    import time
    lock = Path("/tmp/destiny_model_busy.lock")
    for _ in range(60):
        if not lock.exists():
            break
        time.sleep(2)
    payload = {"model": "qwen2.5:14b", "prompt": prompt, "stream": False, "options": {"num_predict": 220, "temperature": 0.3}}
    req = urllib.request.Request("http://127.0.0.1:11434/api/generate", data=json.dumps(payload).encode(), headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=300) as r:
        return json.loads(r.read().decode()).get("response", "").strip()

def _canva_generate(design_type, prompt):
    result = subprocess.run(
        [
            "bash", "-lc",
            'source "$HOME/.nvm/nvm.sh" && node "$1" generate "$2" "$3"',
            "bash", str(CANVA_TOOL), design_type, prompt
        ],
        capture_output=True,
        text=True,
        timeout=300
    )
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or "Canva bridge failed")

    outer = json.loads(result.stdout)
    inner = json.loads(outer["content"][0]["text"])
    designs = inner["job"]["result"]["generated_designs"]
    return [d["url"] for d in designs]


def run():
    i = 0
    if TRACK.exists():
        try:
            i = int(TRACK.read_text().strip())
        except Exception:
            i = 0
    name, folder, job = AGENTS[i % len(AGENTS)]
    folder.mkdir(parents=True, exist_ok=True)
    stamp = datetime.now(timezone.utc).strftime("%Y-%m-%d_%H%M")
    out = folder / (name.lower() + "_work_" + stamp + ".md")
    body = _ask("You are " + name + " under Victoria, CEO of Ozark Prepper only. Your company sells prepper ebooks and must bring in money. " + job)

    canva_jobs = {
        "Fiona": (
            "youtube_thumbnail",
            "Create a professional Ozark Prepper YouTube thumbnail from this design brief. "
            "Rugged, trustworthy, high quality, readable, no clickbait."
