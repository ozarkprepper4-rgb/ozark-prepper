#!/usr/bin/env python3

import sys
from pathlib import Path

BASE = Path("/home/destiny/Obsidian/Destiny/Three_Brain_Architecture")

if BASE.resolve() not in map(Path, sys.path):
    sys.path.insert(0, str(BASE))

from conversation_engine import run


def main():
    if len(sys.argv) < 2:
        print("Usage: talk.py <message>")
        raise SystemExit(1)

    message = " ".join(sys.argv[1:])
    print(run(message))


if __name__ == "__main__":
    main()
