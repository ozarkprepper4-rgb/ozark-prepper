from pathlib import Path

ROOT = Path("/home/destiny/Obsidian")

def run(*a, **k):
    hits = []
    for f in ROOT.glob("**/*"):
        if f.is_file() and any("ozark" in part for part in str(f).lower().split('.')):
            hits.append(str(f))
    return '\n'.join(sorted(hits)) if hits else 'none found'
