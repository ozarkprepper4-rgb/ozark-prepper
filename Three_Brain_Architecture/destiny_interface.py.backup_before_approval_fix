@app.route("/")
def home():
    return render_template_string(PAGE)

@app.route("/ask", methods=["POST"])
def ask():
    data = request.get_json()
    message = data.get("message", "").strip()
    if not message:
        return jsonify({"reply": "Please type something."})
    try:
        result = subprocess.run(
            [sys.executable, DESTINY_TASK, message],
            capture_output=True, text=True, timeout=1800
        )
        output = result.stdout
        if "Destiny:" in output:
            reply = output.split("Destiny:", 1)[1]
            reply = reply.split("=== PIPELINE ===")[0].strip()
        else:
            reply = output.strip() or result.stderr.strip() or "No response produced."
        try:
            from datetime import datetime, timezone
            log_path = Path("/home/destiny/Obsidian/Destiny/Conversation_Log.md")
            entry = f"\n\n## {datetime.now(timezone.utc).strftime('%Y-%m-%d %H:%M UTC')}\n**Neil:** {message}\n**Destiny:** {reply}\n---\n"
            with log_path.open("a", encoding="utf-8") as f:
                f.write(entry)
        except Exception:
            pass
        return jsonify({"reply": reply})
    except subprocess.TimeoutExpired:
        return jsonify({"reply": "This is taking longer than 30 minutes. Try asking again in a bit."})
    except Exception as exc:
        return jsonify({"reply": f"Error running task: {exc}"})

if __name__ == "__main__":
    app.run(host="127.0.0.1", port=8420, debug=False)
