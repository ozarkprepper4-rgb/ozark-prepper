#!/usr/bin/env python3

import sys
from pathlib import Path

BASE = Path("/home/destiny/Obsidian/Destiny/Three_Brain_Architecture")
sys.path.insert(0, str(BASE))

from cognitive_orchestrator import run
from pre_execution_verifier import verify_task


def main():
    if len(sys.argv) < 2:
        print('Usage: destiny "task to perform"')
        raise SystemExit(1)

    task = " ".join(sys.argv[1:])

    print()
    print("=== DESTINY ===")
    print("Task:", task)
    print()

    verification = verify_task(task)

    if verification.get("status") != "READY":
        print("PRE-EXECUTION VERIFICATION: BLOCKED")
        for name, value in verification.get("checks", {}).items():
            print(f"{name}: {'PASS' if value else 'FAIL'}")
        raise SystemExit(1)

    print("Pre-execution verification: PASS")
    print("Three-Brain processing...")
    print()

    result = run(task)

    print("=== RESULT ===")
    print("Status:", result.get("status", "UNKNOWN"))

    response = (
        result.get("model_response")
        or result.get("dl_result", {}).get("model_response", "")
    )

    if response:
        print()
        print("Destiny:")
        print(response)

    print()
    print("=== PIPELINE ===")
    for name, status in result.get("pipeline", {}).items():
        print(f"{name}: {status}")

    print()
    print("DESTINY_TASK_COMPLETE")


if __name__ == "__main__":
    main()
