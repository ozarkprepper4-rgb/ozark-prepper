def _talk(task):
    # Import the conversation engine normally so its short-term
    # conversation memory persists for the life of this process.
    import conversation_engine
    return conversation_engine.run(task)
def _talk_unused(task):
    import json, urllib.request
    payload = {
        "model": "llama3.2:latest",
        "prompt": "You are Destiny, his off-grid assistant and partner. Talking to him now. Call him you. Be warm and plain. Do not invent city news, fake articles, or fake teams. Homestead talk is fine if it fits who you are. Don't ask him to do your work. Two or three sentences.\nNeil: " + task + "\nDestiny:",
        "stream": False,
        "options": {"num_predict": 80, "temperature": 0.7}
    }
    req = urllib.request.Request("http://127.0.0.1:11434/api/generate", data=json.dumps(payload).encode(), headers={"Content-Type":"application/json"})
    with urllib.request.urlopen(req, timeout=60) as r:
        return json.loads(r.read().decode()).get("response", "I'm here, Neil.").strip()

def _skill(name):
    path = SKILLS / (name if name.endswith(".py") else name + ".py")
    spec = importlib.util.spec_from_file_location(name, path)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod

def handle(task):
    task = (task or "").strip()
    lower = task.lower()

    if "secure vault" in lower or "put this in the vault" in lower or "save this to the vault" in lower or "add to the vault" in lower:
        import subprocess
        import re as _re
        group_match = _re.search(r"(?:group|category)[:\s]+([A-Za-z ]+?)(?:,|\n|$)", task, _re.I)
        title_match = _re.search(r"(?:title|name|for)[:\s]+([A-Za-z0-9 ]+?)(?:,|\n|$)", task, _re.I)
        user_match = _re.search(r"(?:username|user)[:\s]+([^\s,]+)", task, _re.I)
        pass_match = _re.search(r"(?:password|key|number)[:\s]+([^\s,]+)", task, _re.I)
        notes_match = _re.search(r"(?:notes)[:\s]+(.+)$", task, _re.I)

        group_name = group_match.group(1).strip() if group_match else "Passwords and Emails"
        title = title_match.group(1).strip() if title_match else "Unnamed Entry"
        username = user_match.group(1).strip() if user_match else ""
        password = pass_match.group(1).strip() if pass_match else ""
        notes = notes_match.group(1).strip() if notes_match else ""

        try:
            result = subprocess.run(
                ["/home/destiny/video_env/bin/python3", "/home/destiny/add_to_vault.py", group_name, title, username, password, notes],
                capture_output=True, text=True, timeout=30
            )
            return {"command": "vault_save", "exit_code": 0, "stdout": result.stdout, "stderr": result.stderr}
        except Exception as e:
            return {"command": "vault_save", "exit_code": 1, "stdout": "", "stderr": str(e)}
    if not task:
        return {"command": "talk", "exit_code": 0, "stdout": "I'm here, Neil.", "stderr": ""}
    if "run this exact command" in lower or "using your run_command tool" in lower:
        return None
    if "youtube.com" in lower or "youtu.be" in lower:
        import re as _re
        import subprocess
        from datetime import datetime
        murl = _re.search(r"https?://\S+", task)
        url = murl.group(0).rstrip(").,]") if murl else task.strip()
        work = Path("/tmp/destiny_video")
        work.mkdir(parents=True, exist_ok=True)
        for oldf in work.glob("*"):
            try:
                oldf.unlink()
            except Exception:
                pass
        cmd = [
            "/home/destiny/Obsidian/Destiny/Three_Brain_Architecture/.venv/bin/yt-dlp", "--skip-download", "--write-auto-sub", "--write-sub",
            "--sub-lang", "en", "--write-auto-subs", "--write-thumbnail", "--convert-thumbnails", "jpg", "--ignore-no-formats-error",
            "-o", str(work / "%(id)s"), url,
        ]
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=180)
        texts = []
        for sub in sorted(work.glob("*.vtt")) + sorted(work.glob("*.srt")):
            raw = sub.read_text(encoding="utf-8", errors="ignore")
            lines = []
            for line in raw.splitlines():
                line = line.strip()
                if not line or line.startswith("WEBVTT") or line.startswith("Kind:") or line.startswith("Language:"):
                    continue
                if "-->" in line or line.isdigit():
                    continue
                line = _re.sub(r"<[^>]+>", "", line)
                if line and (not lines or line != lines[-1]):
                    lines.append(line)
            texts.append(" ".join(lines))
        words = " ".join(texts).strip()
        if not words:
            words = "No captions found. Keep the link. Wait for Neil's words under the video."
        words = words[:6000]
        frames = VAULT / "Video_Frames"
        frames.mkdir(parents=True, exist_ok=True)
        pics = []
        for pic in list(work.glob("*.jpg")) + list(work.glob("*.webp")) + list(work.glob("*.png")):
            dest = frames / pic.name
            dest.write_bytes(pic.read_bytes())
            pics.append(str(dest))
        try:
            ytdlp = "/home/destiny/Obsidian/Destiny/Three_Brain_Architecture/.venv/bin/yt-dlp"
            clip = work / "clip.mp4"
            subprocess.run(
                [ytdlp, "-f", "134/135/133/bestvideo[height<=360]", "--max-filesize", "80M", "-o", str(clip), url],
                capture_output=True, text=True, timeout=180,
            )
            if clip.exists() and clip.stat().st_size > 1000:
                stills_tmp = work / "stills"
                stills_tmp.mkdir(exist_ok=True)
                subprocess.run(
                    ["ffmpeg", "-y", "-i", str(clip), "-vf", "fps=1/20,scale=640:-1", "-q:v", "5", "-vframes", "12", str(stills_tmp / "frame_%02d.jpg")],
                    capture_output=True, text=True, timeout=90,
                )
                vid_id = "video"
                mid = _re.search(r"(?:v=|youtu\.be/)([A-Za-z0-9_-]{6,})", url)
                if mid:
                    vid_id = mid.group(1)
                for i, still in enumerate(sorted(stills_tmp.glob("*.jpg")), 1):
                    dest = frames / f"{vid_id}_{i:02d}.jpg"
                    dest.write_bytes(still.read_bytes())
                    pics.append(str(dest))
                try:
                    clip.unlink()
                except Exception:
                    pass
        except Exception:
            pass
        pic_line = "Pictures: " + (", ".join(pics) if pics else "none")
        log = VAULT / "Video_Learning_Log.md"
        stamp = datetime.now().strftime("%Y-%m-%d %H:%M")
