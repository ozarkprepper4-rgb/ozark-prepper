            title = ef.stem.replace("ebook_", "").replace("_", " ").title()
            cards += '<div class="card"><h3>' + title + '</h3><p>Digital field manual. Instant download.</p><a class="buy" href="' + ef.name + '">Buy Now</a></div>'
        html = "<!DOCTYPE html><html><head><title>" + target + "</title>"
        html += "<style>body{background:#0d0d0d;color:#eee;font-family:Georgia,serif;text-align:center;margin:0;padding:0;}"
        html += "header{background:#1a1a1a;padding:40px 20px;border-bottom:3px solid #e8a33d;}"
        html += "h1{color:#e8a33d;font-size:2.5em;margin:0;}"
        html += ".tagline{color:#aaa;font-size:1.1em;margin-top:10px;}"
        html += ".grid{display:flex;flex-wrap:wrap;justify-content:center;padding:40px 20px;}"
        html += ".card{border:1px solid #444;border-radius:10px;padding:20px;margin:15px;background:#1a1a1a;color:#eee;max-width:320px;}"
        html += ".card h3{color:#e8a33d;}"
        html += ".buy{display:inline-block;background:#2f8f4e;color:white;padding:10px 18px;border-radius:6px;text-decoration:none;font-weight:bold;}</style></head>"
        html += "<body><header><h1>" + target + "</h1><div class='tagline'>Off-grid skills for real people, straight from the Ozarks.</div></header>"
        html += '<div class="grid">' + cards + "</div></body></html>"
        out_path = folder / "index.html"
        out_path.write_text(html, encoding="utf-8")
        return {"command": "build_website", "exit_code": 0, "stdout": "Built full website with " + str(len(ebook_files)) + " ebooks: " + str(out_path), "stderr": ""}
    _identity_save_words = ["save this to your soul", "save to your soul", "save it to your soul", "write this down", "your real identity", "part of your identity", "soul.md", "think about how this applies", "your own real structure", "rewrite this ebook", "completely rewrite", "write the complete new"]
    _is_identity_save = any(x in lower for x in _identity_save_words)
    if "youtube title" in lower or "next_youtube_task" in lower:
        f = Path("/home/destiny/Obsidian/Destiny/next_youtube_task.md")
        title = "Beginner Backup Solar in One Afternoon"
        f.write_text("Book 1: The Simplest Backup Solar Setup for Beginners\nTitle: " + title + "\nDo not publish.\n", encoding="utf-8")
        return {"command": "talk", "exit_code": 0, "stdout": "Wrote title: " + title, "stderr": ""}
    if any(k in lower for k in ("run pipeline", "run the pipeline", "youtube pipeline")):
        import subprocess
        r = subprocess.run(["python3", "/home/destiny/Obsidian/Destiny/Three_Brain_Architecture/run_pipeline.py"], capture_output=True, text=True)
        return {"command": "talk", "exit_code": r.returncode, "stdout": (r.stdout or r.stderr or "pipeline ran")[:800], "stderr": ""}
    if any(k in lower for k in ("who are you", "who do you work for", "your name", "who is destiny")):
        return {"command": "talk", "exit_code": 0, "stdout": "I am Destiny, Neil's personal AI assistant. I handle everything that is not Ozark Prepper. Victoria runs Ozark Prepper.", "stderr": ""}
    if any(k in lower for k in ("youtube", "facebook", "audrey", "bridget", "chloe", "who runs")):
        f = VAULT / "Ozark_Team.md"
        if f.exists():
            note = f.read_text(encoding="utf-8")
            return {"command": "talk", "exit_code": 0, "stdout": "Victoria runs Ozark Prepper YouTube and Facebook through Audrey, Bridget, and Chloe.\n\n" + note, "stderr": ""}
    if any(k in lower for k in ("ebook", "book list", "what books", "catalog")) and not _is_identity_save:
        f = VAULT / "Ozark_Ebook_Catalog.md"
        if f.exists():
            return {"command": "talk", "exit_code": 0, "stdout": f.read_text(encoding="utf-8"), "stderr": ""}
    if any(k in lower for k in ("ebook", "book list", "what books", "catalog")):
