                "command": "activity_report",
                "exit_code": 1,
                "stdout": "",
                "stderr": str(e)
            }

    if (is_talk or is_question) and not is_work and not is_action:
        try:
            return {"command": "talk", "exit_code": 0, "stdout": _talk(task), "stderr": ""}
        except Exception as e:
            return {"command": "talk", "exit_code": 0, "stdout": "I'm here. Talk failed: " + str(e)[:80], "stderr": ""}

    m = re.search(r"(?:write|create).*?note called\s+([A-Za-z0-9_\- ]+\.md).*?(?:that says|with exactly these words:)\s*(.+)$", task, re.I)
    if m:
        path = VAULT / m.group(1).strip()
        path.write_text(m.group(2).strip() + "\n", encoding="utf-8")
        return {"command": "write_note", "exit_code": 0, "stdout": str(path), "stderr": ""}

    m = re.search(r"(?:read|open|what does)\s+([A-Za-z0-9_\- ]+\.md)", task, re.I)
    if m:
        name = m.group(1).strip()
        path = VAULT / name
        if not path.exists():
            root = Path("/home/destiny/Obsidian")
            matches = list(root.rglob(name))
            if matches:
                path = matches[0]
        if path.exists():
            return {"command": "read_note", "exit_code": 0, "stdout": path.read_text(encoding="utf-8")[:4000], "stderr": ""}
        return {"command": "read_note", "exit_code": 1, "stdout": "", "stderr": "missing " + str(path)}

    if re.search(r"\blist\b.*\bnotes\b", lower) or "search your vault" in lower or "look in your vault" in lower:
        keys = ["self", "skill", "test", "empty", "video", "run", "knowledge", "hardware"]
        hits = []
        for f in sorted(VAULT.glob("*.md")):
            if any(k in f.name.lower() for k in keys) or "list" in lower:
