        with log.open("a", encoding="utf-8") as f:
            f.write(block)
        preview = words[:400]
        return {"command": "video_watch", "exit_code": proc.returncode, "stdout": preview, "stderr": ""}
    m = re.search(
        r"^(?:save this|remember this|write this down|put this in (?:a |your )?note|make (?:me )?a note|write a note)[:\s,]+(.+)$",
        task,
        re.I | re.S,
    )
    if m:
        body = m.group(1).strip()
        if body:
            from datetime import datetime
            name = "Note_" + datetime.now().strftime("%Y-%m-%d_%H%M") + ".md"
            path = VAULT / name
            path.write_text(body + "\n", encoding="utf-8")
            return {"command": "write_note", "exit_code": 0, "stdout": str(path), "stderr": ""}

    talk_hits = ["how are you", "how you doing", "how's it going", "hows it going",
