        if f.exists():
            return {"command": "talk", "exit_code": 0, "stdout": f.read_text(encoding="utf-8"), "stderr": ""}
    if any(k in lower for k in ("ebook", "book list", "what books", "catalog")):
        f = VAULT / "Ozark_Ebook_Catalog.md"
        if f.exists():
            return {"command": "talk", "exit_code": 0, "stdout": f.read_text(encoding="utf-8"), "stderr": ""}
    if any(x in lower for x in ["landing", "ozark", "stripe"]) and not _is_identity_save:
        notes = []
        for name in ["Victoria.md", "Ozark Prepper.md", "Website_and_Storefront_Policy.md"]:
            f = VAULT / name
            if f.exists():
                notes.append(name + "\n" + f.read_text(encoding="utf-8")[:800])
        blob = "\n\n".join(notes)[:2500]
        try:
            return {"command": "talk", "exit_code": 0, "stdout": _talk(task + "\n\nVAULT NOTES:\n" + blob), "stderr": ""}
        except Exception as e:
            return {"command": "talk", "exit_code": 0, "stdout": blob or str(e), "stderr": ""}

    if any(k in lower for k in ("youtube", "facebook", "audrey", "bridget", "chloe", "who runs")):
        f = VAULT / "Ozark_Team.md"
        if f.exists():
            note = f.read_text(encoding="utf-8")
            return {"command": "talk", "exit_code": 0, "stdout": "Victoria runs Ozark Prepper YouTube and Facebook through Audrey, Bridget, and Chloe.\n\n" + note, "stderr": ""}
    if "victoria" in lower:
        f = VAULT / "Victoria.md"
        if f.exists():
            lines = [ln for ln in f.read_text(encoding="utf-8").splitlines() if not ln.startswith("## Web learn") and not ln.startswith("[{")]
            note = "\n".join(lines[:25])
            try:
                return {"command": "talk", "exit_code": 0, "stdout": _talk("Answer from this note only. Two sentences.\n" + note + "\n\nQuestion: " + task), "stderr": ""}
            except Exception:
                return {"command": "talk", "exit_code": 0, "stdout": "Victoria is Neil's CEO agent. She plans the work, directs the other agents, and keeps Ozark Prepper moving.", "stderr": ""}
    # Unknown conversational requests and questions belong in the
    # Obsidian-connected talk path. Never create a skill merely because
    # the router did not recognize the wording.
    if not is_action:
        try:
            return {"command": "talk", "exit_code": 0, "stdout": _talk(task), "stderr": ""}
        except Exception as e:
            return {"command": "talk", "exit_code": 1, "stdout": "", "stderr": str(e)}

    # Auto-forge is reserved for genuine action/build requests.
    try:
        forge = _skill("forge_skill")
        skill_name = "auto_" + "".join(ch if ch.isalnum() else "_" for ch in task[:40]).strip("_").lower()
        result = forge.run(skill_name, task)
        return {"command": "auto_forge", "exit_code": 0, "stdout": str(result), "stderr": ""}
    except Exception as e:
        from datetime import datetime, timezone
        fail_log = Path("/home/destiny/Obsidian/Destiny/Auto_Forge_Failures.md")
        diagnosis_result = None
        try:
            diag_path = SKILLS / "diagnose_and_fix.py"
            diag_spec = importlib.util.spec_from_file_location("diagnose_and_fix", diag_path)
            diag = importlib.util.module_from_spec(diag_spec)
            diag_spec.loader.exec_module(diag)
            forge_path = "/home/destiny/Obsidian/Destiny/Three_Brain_Architecture/skills/forge_skill.py"
            diagnosis_result = diag.run(forge_path, "Task failed with this error: " + str(e))
        except Exception as diag_error:
            diagnosis_result = {"status": "diagnosis_attempt_failed", "error": str(diag_error)}
        entry = "\n\n## " + datetime.now(timezone.utc).strftime('%Y-%m-%d %H:%M UTC') + "\n**Task:** " + task + "\n**Error:** " + str(e) + "\n**Self-repair attempt:** " + str(diagnosis_result) + "\n---\n"
        with fail_log.open("a", encoding="utf-8") as f:
            f.write(entry)
        if diagnosis_result and diagnosis_result.get("status") == "applied":
            return {"command": "auto_forge_self_repaired", "exit_code": 0, "stdout": "Detected failure and applied a self-repair. Please retry your request.", "stderr": ""}
        return {"command": "auto_forge_failed", "exit_code": 1, "stdout": "", "stderr": str(e)}
