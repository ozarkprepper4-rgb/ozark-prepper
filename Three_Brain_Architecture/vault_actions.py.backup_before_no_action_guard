            hits = [f.name + " (" + str(f.stat().st_size) + " bytes)" for f in sorted(VAULT.glob("*.md"))[:10]]
        return {"command": "list_notes", "exit_code": 0, "stdout": "\n".join(hits[:20]), "stderr": ""}

    if lower.startswith("save this video lesson:"):
        text = task.split(":", 1)[1].strip()
        first = text.split(".")[0].strip()[:60]
        name = "Video_" + "".join(ch if ch.isalnum() else "_" for ch in first).strip("_") + ".md"
        path = VAULT / name
        path.write_text("# " + first + "\n\n" + text + "\n", encoding="utf-8")
        return {"command": "save_video_lesson", "exit_code": 0, "stdout": str(path), "stderr": ""}

    if "run your self check" in lower or "clean your vault" in lower:
        lock_path = Path("/tmp/destiny_model_busy.lock")
        with lock_path.open("w") as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                return {"command": "self_run", "exit_code": 0, "stdout": "Destiny is already working on another model task.", "stderr": ""}

            lock.write("vault_actions:self_run")
            lock.flush()
            return {"command": "self_run", "exit_code": 0, "stdout": str(_skill("self_run").run()), "stderr": ""}

    if "use clean_knowledge_base" in lower or "clean knowledge_base" in lower:
        return {"command": "clean_knowledge_base", "exit_code": 0, "stdout": str(_skill("clean_knowledge_base").run()), "stderr": ""}

    m = re.search(r"(?:i need a skill called|add a skill called)\s+([A-Za-z0-9_\-]+)", task, re.I)
    if m:
        path = _skill("forge_skill").run(m.group(1), task)
        return {"command": "forge_skill", "exit_code": 0, "stdout": str(path), "stderr": ""}

