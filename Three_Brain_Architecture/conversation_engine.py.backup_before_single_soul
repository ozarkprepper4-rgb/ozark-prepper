def _load_relevant_memory(task):
    task_words = {
        word.strip(".,!?").lower()
        for word in task.split()
        if len(word.strip(".,!?")) >= 4
    }

    priority_names = (
        "Destiny.md",
        "SOUL.md",
        "Neil SOUL.md",
        "Knowledge_Base.md",
    )

    parts = []

    for f in sorted(VAULT.rglob("*.md")):
        try:
            text = f.read_text(encoding="utf-8", errors="ignore")
        except Exception:
            continue

        lower = text.lower()

        score = sum(1 for word in task_words if word in lower)

        # Prefer the Knowledge Base for concrete factual questions.
        if f.name == "Knowledge_Base.md":
            score += 5
        elif f.name in priority_names:
            score += 1

        # Strongly prefer files whose filename is explicitly referenced.
        filename_words = f.stem.lower().replace("_", " ").split()
        score += sum(3 for word in filename_words if word in task_words)

        if score > 0:
            parts.append((score, f.name + ":\n" + text[:1800]))

    parts.sort(key=lambda x: x[0], reverse=True)

    # Explicit persistent-memory hierarchy.
    # SOUL.md is Destiny's authoritative identity source.
    guaranteed = []
    priority_order = (
        "SOUL.md",
        "Destiny.md",
        "Neil SOUL.md",
        "Knowledge_Base.md",
    )

    all_notes = list(VAULT.rglob("*.md"))
    for name in priority_order:
        for f in all_notes:
            if f.name == name:
                try:
                    text = f.read_text(encoding="utf-8", errors="ignore")
                    guaranteed.append(f.name + ":\n" + text[:1800])
                except Exception:
                    pass
                break

    combined = guaranteed + [text for _, text in parts[:5] if text not in guaranteed]
    return "\n\n".join(combined)[:7000]


def run(task):
    if False and _is_casual(task):  # disabled: unified Obsidian-backed conversation
        recent = _recent_context()

        # Load Destiny's persistent identity for normal conversation.
        identity_parts = []
        for identity_path in (
            Path("/home/destiny/Obsidian/SOUL.md"),
            Path("/home/destiny/Obsidian/Destiny/Destiny.md"),
        ):
            try:
                if identity_path.exists():
                    identity_parts.append(
                        identity_path.read_text(
                            encoding="utf-8",
                            errors="ignore"
                        )[:2500]
                    )
            except Exception:
                pass

        identity_memory = "\n\n".join(identity_parts)[:4000]
