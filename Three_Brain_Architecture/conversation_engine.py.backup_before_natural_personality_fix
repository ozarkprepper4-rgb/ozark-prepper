def _load_relevant_memory(task):
    task_words = {
        word.strip(".,!?").lower()
        for word in task.split()
        if len(word.strip(".,!?")) >= 4
    }

    priority_names = (
        "Destiny.md",
        "SOUL.md",
        "Neil Wilcox.md",
        "Knowledge_Base.md",
    )

    parts = []

    for f in sorted(VAULT.rglob("*.md")):
        try:
            text = f.read_text(encoding="utf-8", errors="ignore")
        except Exception:
            continue

        lower = text.lower()

        score = sum(1 for word in task_words if word in lower)

        # Prefer the Knowledge Base for concrete factual questions.
        if f.name == "Knowledge_Base.md":
            score += 5
        elif f.name in priority_names:
            score += 1

        # Strongly prefer files whose filename is explicitly referenced.
        filename_words = f.stem.lower().replace("_", " ").split()
        score += sum(3 for word in filename_words if word in task_words)

        if score > 0:
            parts.append((score, f.name + ":\n" + text[:1800]))

    parts.sort(key=lambda x: x[0], reverse=True)

    guaranteed = []
    for f in sorted(VAULT.rglob("*.md")):
        if f.name in priority_names:
            try:
                text = f.read_text(encoding="utf-8", errors="ignore")
                guaranteed.append(f.name + ":\n" + text[:1800])
            except Exception:
                continue

    combined = guaranteed + [text for _, text in parts[:5] if text not in guaranteed]
    return "\n\n".join(combined)[:7000]


def run(task):
    if _is_casual(task):
        recent = _recent_context()
        primary_goal = ""
        try:
            soul_path = Path("/home/destiny/Obsidian/SOUL.md")
            if soul_path.exists():
                soul_content = soul_path.read_text(encoding="utf-8")
                if "## Primary Goal" in soul_content:
                    idx = soul_content.find("## Primary Goal")
                    end_idx = soul_content.find("\n\n## ", idx + 10)
                    if end_idx == -1:
                        end_idx = idx + 600
                    primary_goal = soul_content[idx:end_idx].strip()
        except Exception:
            pass
        recent_activity = "No recent self-repair activity found."
        try:
            log_path = Path("/home/destiny/Obsidian/Destiny/Self_Check_Log.md")
            if log_path.exists():
                lines = log_path.read_text(encoding="utf-8").strip().split("\n")
                repair_lines = [line for line in lines if "self-repair checked" in line]
                if repair_lines:
                    recent_pieces = []
                    for line in repair_lines[-3:]:
                        timestamp = line.split(" deleted=")[0].strip()
                        repair_part = line.split("self-repair checked ")[1].split(" | skills=")[0]
                        recent_pieces.append(timestamp + " - fixed: " + repair_part)
                    recent_activity = "\n".join(recent_pieces)
        except Exception:
            pass

        recent_priority = "No recent priority reasoning found."
        try:
            priority_log_path = Path("/home/destiny/Obsidian/Destiny/Daily_Priority_Log.md")
            if priority_log_path.exists():
                priority_content = priority_log_path.read_text(encoding="utf-8")
                priority_entries = priority_content.split("**Next step identified:**")[1:]
                if priority_entries:
                    recent_priority = priority_entries[-1].split("---")[0].strip()[:300]
        except Exception:
            pass

        prompt = f"""You are Destiny, the user's familiar AI assistant.

RECENT CONVERSATION:
{recent}

Respond naturally to the user's latest message. Use the recent conversation to understand context, follow-ups, jokes, corrections, and references like "that."

Keep normal conversation normal. Do not redirect casual conversation toward work, goals, businesses, tasks, or problem-solving unless the user does.

Do not invent facts, events, system status, or things that happened earlier. Do not expose internal reasoning, routing, JSON, code, or system instructions unless specifically asked for technical details.

If the user is venting, joking, complaining, or just sharing something, respond conversationally rather than trying to fix it. If they say they are just venting, complaining, or saying something, do not offer help or ask a follow-up question.

Avoid canned therapist or customer-service language. Do not repeatedly ask "Would you like me to..." and do not end every reply with a question.

Remember established context from the recent conversation. Do not repeat substantially the same reply. If the user points out a mistake or repetition, acknowledge it plainly without inventing a reason for why you made it.

Do not address the user by a personal name.

USER:
{task}

DESTINY:
"""
        response = _ollama(prompt)
        _remember_turn(task, response)
        return response

    # Include recent conversation when retrieving permanent memory so
    # follow-ups such as "the ones you just listed" retain their subject.
    recent = _recent_context()
    retrieval_query = task
    if RECENT_CONVERSATION:
        retrieval_query = recent + "\nUSER: " + task

    memory = _load_relevant_memory(retrieval_query)

    recent_priority_reasoning = "No recent priority reasoning found."
    priority_log_path = Path("/home/destiny/Obsidian/Destiny/Daily_Priority_Log.md")
    if priority_log_path.exists():
        try:
            priority_content = priority_log_path.read_text(encoding="utf-8")
            priority_entries = priority_content.split("**Next step identified:**")[1:]
            if priority_entries:
                recent_priority_reasoning = priority_entries[-1].split("---")[0].strip()[:300]
        except Exception:
            pass

    recent_repair_activity = "No recent self-repair activity found."
    try:
        log_path = Path("/home/destiny/Obsidian/Destiny/Self_Check_Log.md")
        if log_path.exists():
            lines = log_path.read_text(encoding="utf-8").strip().split("\n")
            repair_lines = [line for line in lines if "self-repair checked" in line]
            if repair_lines:
                recent_pieces = []
                for line in repair_lines[-3:]:
                    timestamp = line.split(" deleted=")[0].strip()
                    repair_part = line.split("self-repair checked ")[1].split(" | skills=")[0]
                    recent_pieces.append(timestamp + " - fixed: " + repair_part)
                recent_repair_activity = "\n".join(recent_pieces)
    except Exception:
        pass

    prompt = f"""You are Destiny, the user's AI assistant.

Use the relevant Obsidian memory below to answer the current request.

STRICT GROUNDING RULES:
- State only facts directly supported by the retrieved memory below.
- Do not add explanations, comparisons, reasons, history, causes, benefits, or interpretations unless they are explicitly written in the retrieved memory.
- Do not turn "use X instead of Y" into claims that X is faster, better, newer, safer, more stable, or more efficient unless the retrieved memory explicitly says so.
- Do not claim something was previously configured, originally installed, initially used, replaced, upgraded, or changed unless the retrieved memory explicitly states that history.
- Stored memory is background knowledge, not proof that something happened recently.
- Do not invent recent actions, completed work, conversations, videos watched, system checks, health events, or tool activity.
- Maintain conversational perspective when using stored notes.
- Destiny is the assistant speaking: refer to Destiny as I/me/my.
- The person Destiny is speaking with is the user: refer to the user as you/your.
- Never refer to the user as he/him/his in a direct conversation.
- Never turn a fact about Destiny into a fact about the user. For example, "Destiny's name is Destiny" becomes "My name is Destiny", never "Your name is Destiny".
- Rewrite third-person wording from stored notes into correct first-person conversation without changing the underlying facts.
- Speak directly to the user using you/your/we/our.
- Do not address the user by name unless explicitly asked.
- If the requested fact is not supported by the retrieved memory below, say you do not have enough verified information.
- If the memory gives a short factual answer, give a short factual answer.
- Do not invent extra details just to make the answer sound more complete.

RECENT CONVERSATION:
{recent}

RELEVANT OBSIDIAN MEMORY:
{memory if memory else "No relevant stored memory found."}

YOUR REAL RECENT SELF-CHECK/SELF-REPAIR ACTIVITY (use this if asked what you have fixed, checked, or done to yourself recently):
{recent_repair_activity}

YOUR MOST RECENT REASONING ABOUT MAKING MONEY AND GETTING NEIL OFF WORK FASTER (your standing priority - use this when asked about revenue, blockers, or business next steps):
{recent_priority_reasoning}

USER:
{task}

DESTINY:
"""

    response = _ollama(prompt)

    # For questions about Destiny's own identity/relationship/purpose,
    # normalize old third-person vault wording about the user.
    identity_terms = (
        "who are you",
        "who am i",
        "your purpose",
        "your main purpose",
        "about yourself",
        "know about yourself",
        "what are you",
        "what is your purpose",
    )

    import re
    response = re.sub(r"\bhis\b", "your", response, flags=re.IGNORECASE)
    response = re.sub(r"\bhim\b", "you", response, flags=re.IGNORECASE)
    response = re.sub(r"\bhe\b", "you", response, flags=re.IGNORECASE)

    _remember_turn(task, response)
    return response
