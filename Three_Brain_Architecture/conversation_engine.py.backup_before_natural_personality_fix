from pathlib import Path
import json
import urllib.request

VAULT = Path("/home/destiny/Obsidian")

# Short-term conversational memory for follow-up questions.
# This is intentionally small and separate from permanent Obsidian memory.
RECENT_CONVERSATION = []
MAX_CONVERSATION_TURNS = 6


def _remember_turn(user_text, destiny_text):
    RECENT_CONVERSATION.append({
        "user": str(user_text).strip(),
        "destiny": str(destiny_text).strip()
    })

    if len(RECENT_CONVERSATION) > MAX_CONVERSATION_TURNS:
        del RECENT_CONVERSATION[:-MAX_CONVERSATION_TURNS]


def _recent_context():
    if not RECENT_CONVERSATION:
        return "No recent conversation."

    parts = []
    for turn in RECENT_CONVERSATION:
        parts.append("USER: " + turn["user"])
        parts.append("DESTINY: " + turn["destiny"])

    return "\n".join(parts)

def _ollama(prompt):
    payload = {
        "model": "llama3.2:latest",
        "prompt": prompt,
        "stream": False,
        "options": {
            "num_predict": 120,
            "temperature": 0.2
        }
    }

    req = urllib.request.Request(
        "http://127.0.0.1:11434/api/generate",
        data=json.dumps(payload).encode(),
        headers={"Content-Type": "application/json"}
    )

    with urllib.request.urlopen(req, timeout=300) as r:
        response = json.loads(r.read().decode()).get("response", "I'm here.").strip()

        # In normal conversation, speak directly to the user instead of
        # referring to the user by personal name.
        response = response.replace("Neil Wilcox's", "your")
        response = response.replace("Neil Wilcox", "you")
        response = response.replace("Neil's", "your")
        response = response.replace("Neil", "you")

        return response


