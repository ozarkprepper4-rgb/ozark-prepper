    # ========================================================
    # CORE ANIMATION
    # ========================================================

    def animate_core(self):

        c = self.core_canvas
        c.delete("all")

        cx = 60
        cy = 40

        self.core_phase += 0.08

        pulse = (
            math.sin(
                self.core_phase
            ) + 1
        ) / 2

        outer = 28 + pulse * 5
        middle = 19 + pulse * 3
        inner = 8 + pulse * 2

        c.create_oval(
            cx - outer,
            cy - outer,
            cx + outer,
            cy + outer,
            outline=CYAN_DIM,
            width=2
        )

        c.create_oval(
            cx - middle,
            cy - middle,
            cx + middle,
            cy + middle,
            outline=BLUE,
            width=2
        )

        c.create_oval(
            cx - inner,
            cy - inner,
            cx + inner,
            cy + inner,
            fill=CYAN,
            outline=""
        )

        angle = self.core_phase * 2

        for offset in (
            0,
            math.pi
        ):
            x = cx + math.cos(
                angle + offset
            ) * 34

            y = cy + math.sin(
                angle + offset
            ) * 34

            c.create_oval(
                x - 3,
                y - 3,
                x + 3,
                y + 3,
                fill=GREEN,
                outline=""
            )

        self.root.after(
            50,
            self.animate_core
        )

    # ========================================================
    # CLOCK
