    def add_chat(self, speaker, text):
        self.chat.configure(state="normal")

        timestamp = datetime.now().strftime("%H:%M:%S")

        self.chat.insert(
            tk.END,
            f"[{timestamp}] {speaker}\n",
            ("speaker",)
        )

        self.chat.insert(
            tk.END,
            f"{text}\n\n"
        )

        self.chat.tag_config(
            "speaker",
            foreground=CYAN,
            font=("Arial", 10, "bold")
        )

        self.chat.see(tk.END)
        self.chat.configure(state="disabled")

    def send(self, event=None):
        if self.running_task:
            return "break"

        message = self.entry.get(
            "1.0",
            tk.END
        ).strip()

        if not message:
            return "break"

        self.entry.delete(
            "1.0",
            tk.END
        )

        self.add_chat(
            "NEIL",
            message
        )

        self.running_task = True
        self.set_status(
            "PROCESSING",
            YELLOW
        )

        self.log_activity(
            "TASK",
            message
        )

        threading.Thread(
            target=self.process_task,
            args=(message,),
            daemon=True
        ).start()

        return "break"

    def process_task(self, message):

        try:
            result = run(message)

            if isinstance(result, dict):
                response = (
                    result.get("model_response")
                    or result.get("message")
                    or result.get("stdout")
                    or str(result)
                )
            else:
                response = str(result)

            self.task_count += 1

            self.root.after(
                0,
                lambda: self.finish_task(
                    response,
                    True
                )
            )

        except Exception as exc:

            self.root.after(
                0,
                lambda: self.finish_task(
                    f"Error: {exc}",
                    False
                )
            )

    def finish_task(
        self,
        response,
        success
    ):
        self.add_chat(
            "DESTINY",
            response
        )

        self.task_label.configure(
            text=f"TASKS PROCESSED: {self.task_count}"
        )

        if success:
            self.set_status(
                "READY",
                GREEN
            )
            self.log_activity(
                "COMPLETE",
                "Task completed."
            )
        else:
            self.set_status(
                "ERROR",
                RED
            )
            self.log_activity(
                "ERROR",
                response
            )

        self.running_task = False

    def clear_chat(self):
        self.chat.configure(state="normal")
        self.chat.delete(
            "1.0",
            tk.END
        )
        self.chat.configure(state="disabled")

        self.add_chat(
