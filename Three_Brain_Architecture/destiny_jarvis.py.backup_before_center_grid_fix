    def copy_all_chat(self):
        content = self.chat.get(
            "1.0",
            tk.END
        ).strip()

        self.root.clipboard_clear()
        self.root.clipboard_append(
            content
        )

        self.log_activity(
            "CLIPBOARD",
            "Conversation copied."
        )

    # ========================================================
    # VOICE PROCESS
    # ========================================================

    def start_voice(self):

        if not VOICE_SCRIPT.exists():
            messagebox.showerror(
                "Destiny Voice",
                "destiny_voice.py was not found."
            )
            return

        if (
            self.voice_process
            and self.voice_process.poll() is None
        ):
            self.voice_status_label.configure(
                text="VOICE: RUNNING",
                fg=GREEN
            )
            return

        try:
            self.voice_process = subprocess.Popen(
                [
                    sys.executable,
                    str(VOICE_SCRIPT)
                ],
                cwd=str(BASE)
            )

            self.voice_status_label.configure(
                text="VOICE: LISTENING",
                fg=GREEN
            )

            self.log_activity(
                "VOICE",
                "Voice operator started."
            )

        except Exception as exc:
            self.voice_status_label.configure(
                text="VOICE: ERROR",
                fg=RED
            )

            self.log_activity(
                "VOICE ERROR",
                str(exc)
            )

    def stop_voice(self):

        if (
            self.voice_process
            and self.voice_process.poll() is None
        ):
            try:
                self.voice_process.terminate()

                try:
                    self.voice_process.wait(
                        timeout=3
                    )
                except subprocess.TimeoutExpired:
                    self.voice_process.kill()

            except Exception:
                pass

        self.voice_process = None

        self.voice_status_label.configure(
            text="VOICE: STANDBY",
            fg=TEXT_DIM
        )

        self.log_activity(
            "VOICE",
            "Voice operator stopped."
        )

