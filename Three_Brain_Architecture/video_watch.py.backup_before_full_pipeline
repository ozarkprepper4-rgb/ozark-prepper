#!/usr/bin/env python3
import json
import fcntl
import re
import urllib.request
from pathlib import Path
from youtube_transcript_api import YouTubeTranscriptApi


def extract_video_id(url_or_id):
    if len(url_or_id) == 11 and "/" not in url_or_id:
        return url_or_id
    match = re.search(r'(?:v=|youtu\.be/|embed/)([A-Za-z0-9_-]{11})', url_or_id)
    return match.group(1) if match else None


def _format_timestamp(seconds):
    seconds = int(seconds or 0)
    hours, remainder = divmod(seconds, 3600)
    minutes, seconds = divmod(remainder, 60)

    if hours:
        return f"{hours:02d}:{minutes:02d}:{seconds:02d}"
    return f"{minutes:02d}:{seconds:02d}"


def chunk_segments(segments, max_chars=6000):
    """Split a complete transcript into timestamped chunks without losing segments."""
    chunks = []
    current = []
    current_chars = 0

    for segment in segments:
        line = f'[{segment["timestamp"]}] {segment["text"]}'
        line_size = len(line) + 1

        if current and current_chars + line_size > max_chars:
            chunks.append({
                "start": current[0]["timestamp"],
                "end": current[-1]["timestamp"],
                "start_seconds": current[0]["start"],
                "end_seconds": current[-1]["start"],
                "text": "\n".join(
                    f'[{item["timestamp"]}] {item["text"]}'
                    for item in current
                )
            })
            current = []
            current_chars = 0

        current.append(segment)
        current_chars += line_size

    if current:
        chunks.append({
            "start": current[0]["timestamp"],
            "end": current[-1]["timestamp"],
            "start_seconds": current[0]["start"],
            "end_seconds": current[-1]["start"],
            "text": "\n".join(
                f'[{item["timestamp"]}] {item["text"]}'
                for item in current
            )
        })

    return chunks



def align_visuals_to_chunks(chunks, visual_frames):
    """Attach each visual frame to the transcript chunk covering that time."""
    aligned = []

    for chunk in chunks:
        item = dict(chunk)
        start = chunk["start_seconds"]
        end = chunk["end_seconds"]

        item["visual_frames"] = [
            frame for frame in visual_frames
            if start <= frame.get("time_seconds", -1) <= end
        ]

        aligned.append(item)

    return aligned


def analyze_chunk(chunk, chunk_number, total_chunks, model="qwen2.5:14b"):
    """Analyze one transcript chunk together with any aligned visual observations."""

    visual_frames = chunk.get("visual_frames", [])
    if visual_frames:
        visual_text = "\n".join(
            f'[{frame["timestamp"]}] {frame.get("description", "")}'
            for frame in visual_frames
        )
    else:
        visual_text = "No visual observations were captured for this section."

    prompt = f"""You are analyzing section {chunk_number} of {total_chunks} from a video.

TIME RANGE: {chunk["start"]} to {chunk["end"]}

TRANSCRIPT:
{chunk["text"]}

VISUAL OBSERVATIONS:
{visual_text}

Analyze THIS ENTIRE SECTION carefully using BOTH the spoken transcript and the visual observations.
Preserve the important details rather than giving a vague summary.
When a visual observation reveals an interface, diagram, code, demonstration, object, action, or on-screen information that adds meaning beyond the transcript, include it.
Do not invent visual details that are not present in the observations.

Return:
- Every major subject, technology, concept, or event discussed.
- Important finer details, examples, predictions, capabilities, limitations, and consequences.
- Any numbered/listed items introduced in this section.
- Important connections to earlier or later ideas when the transcript indicates them.
- Useful timestamps for significant topics.

Do not invent information that is not present in this section.
"""

    payload = json.dumps({
        "model": model,
        "prompt": prompt,
        "stream": False,
        "options": {
            "temperature": 0.1,
            "num_predict": 1200
        }
    }).encode("utf-8")

    request = urllib.request.Request(
        "http://127.0.0.1:11434/api/generate",
        data=payload,
        headers={"Content-Type": "application/json"}
    )

    lock_path = Path("/tmp/destiny_model_busy.lock")
    with lock_path.open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        lock.write("video_watch:qwen_chunk")
        lock.flush()

        with urllib.request.urlopen(request, timeout=300) as response:
            result = json.loads(response.read().decode("utf-8"))

    return result.get("response", "").strip()


def analyze_chunks(chunks, model="qwen2.5:14b", checkpoint_path=None):
    """Analyze sequentially and save each completed chunk so interrupted jobs can resume."""
    checkpoint = Path(checkpoint_path) if checkpoint_path else None
    analyses = []

    if checkpoint and checkpoint.exists():
        try:
            saved = json.loads(checkpoint.read_text(encoding="utf-8"))
            if isinstance(saved, list):
                analyses = saved
        except Exception:
            analyses = []

    completed = {item.get("chunk") for item in analyses}

    for index, chunk in enumerate(chunks, 1):
        if index in completed:
            print(f"CHUNK {index} ALREADY COMPLETE — RESUMING")
            continue

        print(f"ANALYZING CHUNK {index} OF {len(chunks)}")

        try:
            analysis = analyze_chunk(
                chunk,
                index,
                len(chunks),
                model=model
            )
        except Exception as exc:
            raise RuntimeError(
                f"Chunk {index} stopped safely. Completed chunks remain checkpointed. "
                f"Resume after Ollama is healthy. Error: {exc}"
            ) from exc

        analyses.append({
            "chunk": index,
            "start": chunk["start"],
            "end": chunk["end"],
            "analysis": analysis
        })

        analyses.sort(key=lambda item: item["chunk"])

        if checkpoint:
            checkpoint.parent.mkdir(parents=True, exist_ok=True)
            checkpoint.write_text(
                json.dumps(analyses, indent=2),
                encoding="utf-8"
            )

        print(f"CHUNK {index} SAVED")

    return analyses


def synthesize_video(analyses, model="qwen2.5:14b"):
    """Hierarchically combine section analyses without overflowing model context."""

    if not analyses:
        return ""

    items = [
        {
            "label": f'SECTION {item["chunk"]} ({item["start"]} to {item["end"]})',
            "text": item["analysis"]
        }
        for item in analyses
    ]

    def combine_group(group, final=False):
        combined = "\n\n".join(
            f'=== {item["label"]} ===\n{item["text"]}'
            for item in group
        )

        if final:
            instruction = """Create the final coherent understanding of the entire video.
Preserve all major technologies, subjects, numbered items, concepts, predictions,
demonstrations, examples, relationships, useful timestamps, and important details.
Reconstruct complete numbered lists in order when present.
Distinguish speculation/predictions from current or demonstrated capabilities when possible.
Do not invent anything."""
            num_predict = 1800
        else:
            instruction = """Merge these consecutive video sections into one detailed summary.
Preserve every major subject, numbered item, technology, prediction, example,
important detail, relationship, and useful timestamp.
Do not drop later material and do not invent anything."""
            num_predict = 1000

        prompt = f"""You are combining consecutive parts of one video.

{combined}

{instruction}
"""

        payload = json.dumps({
            "model": model,
            "prompt": prompt,
            "stream": False,
            "options": {
                "temperature": 0.1,
                "num_predict": num_predict
            }
        }).encode("utf-8")

        request = urllib.request.Request(
            "http://127.0.0.1:11434/api/generate",
            data=payload,
            headers={"Content-Type": "application/json"}
        )

        lock_path = Path("/tmp/destiny_model_busy.lock")
        with lock_path.open("w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            lock.write("video_watch:qwen_synthesis")
            lock.flush()

            with urllib.request.urlopen(request, timeout=600) as response:
                result = json.loads(response.read().decode("utf-8"))

        return result.get("response", "").strip()

    level = 1

    while len(items) > 2:
        next_items = []

        for i in range(0, len(items), 2):
            group = items[i:i + 2]

            if len(group) == 1:
                next_items.append(group[0])
                continue

            print(f"SYNTHESIS LEVEL {level}: GROUP {i // 2 + 1}")
            summary = combine_group(group)

            next_items.append({
                "label": f"SYNTHESIS LEVEL {level} GROUP {i // 2 + 1}",
                "text": summary
            })

        items = next_items
        level += 1

    print("FINAL VIDEO SYNTHESIS")
    return combine_group(items, final=True)

def watch_video(url_or_id, max_chars=None):
    video_id = extract_video_id(url_or_id)
    if not video_id:
        return {"error": "Could not extract video ID"}

    transcript = YouTubeTranscriptApi().fetch(video_id).to_raw_data()

    segments = []
    for entry in transcript:
        text = entry.get("text", "").strip()
        if not text:
            continue

        start = float(entry.get("start", 0))
        segments.append({
            "start": start,
            "timestamp": _format_timestamp(start),
            "text": text
        })

    full_text = " ".join(segment["text"] for segment in segments)
    timestamped_text = "\n".join(
        f'[{segment["timestamp"]}] {segment["text"]}'
        for segment in segments
    )

    # max_chars remains supported for older callers, but None means
    # return the complete transcript without silently throwing content away.
    output_text = full_text if max_chars is None else full_text[:max_chars]

    chunks = chunk_segments(segments)

    # Capture visual observations and align them with the transcript chunks.
    visual_frames = []
    visual_error = None

    try:
        from video_watch_visual import watch_video_visual
        visual_result = watch_video_visual(video_id)

        if visual_result.get("error"):
            visual_error = visual_result["error"]
        else:
            visual_frames = visual_result.get("visual_frames", [])
            chunks = align_visuals_to_chunks(chunks, visual_frames)

    except Exception as exc:
        visual_error = str(exc)

    return {
        "video_id": video_id,
        "transcript_summary": output_text,
        "full_transcript": full_text,
        "timestamped_transcript": timestamped_text,
        "segments": segments,
        "full_length": len(full_text),
        "segment_count": len(segments),
        "chunks": chunks,
        "chunk_count": len(chunks),
        "visual_frames": visual_frames,
        "visual_frame_count": len(visual_frames),
        "visual_error": visual_error
    }


if __name__ == "__main__":
    import sys
    q = sys.argv[1] if len(sys.argv) > 1 else "dQw4w9WgXcQ"
    print(json.dumps(watch_video(q), indent=2))
